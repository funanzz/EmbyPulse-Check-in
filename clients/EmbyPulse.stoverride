name: EmbyPulse 自动签到
desc: 多个 EmbyPulse 实例每日签到，按站点开启积分续期。请手动添加 MitM 域名。
arguments-version: 1
arguments:
  instances:
    type: input
    title: 实例列表
    description: 用英文分号分隔 HTTPS 门户地址，需续期的站点加 |renew。
    required: true
  cron:
    type: input
    title: 签到时间
    description: 使用设备本地时间，默认每天 08:00。
    default: '0 8 * * *'
    required: true

http:
  script:
    - match: '^https://[A-Za-z0-9.-]+(?::[0-9]+)?/api/(?:user/points/info|requests/logout)(?:\?[^#]*)?$'
      name: embypulse-checkin
      type: response
      require-body: true
      argument: 'proxy:${args.instances}'

cron:
  script:
    - name: embypulse-checkin
      cron: '${args.cron}'
      timeout: 70
      argument: 'proxy:${args.instances}'

script-providers:
  embypulse-checkin:
    url: https://raw.githubusercontent.com/funanzz/EmbyPulse-Check-in/refs/heads/main/embypulse-checkin.js
    interval: 86400
